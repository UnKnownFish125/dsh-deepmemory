{
  "basic": {
    "description": "基础连接",
    "type": "object",
    "items": {
      "server_url": {
        "description": "记忆后端地址",
        "hint": "memory-server 的 HTTP 地址，可指向远程部署",
        "type": "string",
        "default": "http://localhost:6230"
      },
      "workspace": {
        "description": "工作区标识",
        "hint": "绑定工作区级记忆的标识；换项目时修改，新记忆写入新工作区",
        "type": "string",
        "default": "deepseek-harness"
      }
    }
  },
  "embedding": {
    "description": "向量嵌入（本地模型或 API，二选一）",
    "type": "object",
    "items": {
      "provider": {
        "description": "嵌入提供方",
        "hint": "local=本地 fastembed 推理（默认，推荐）；api=OpenAI 兼容 /v1/embeddings 接口",
        "type": "string",
        "options": [
          "local",
          "api"
        ],
        "default": "local"
      },
      "local_model": {
        "description": "本地嵌入模型",
        "hint": "推荐 BAAI/bge-small-zh-v1.5（512 维，中文效果好、体积小），首次使用自动从 HF 镜像下载",
        "type": "string",
        "default": "BAAI/bge-small-zh-v1.5"
      },
      "api_base_url": {
        "description": "API 嵌入地址",
        "hint": "provider=api 时必填，OpenAI 兼容 embeddings 接口根地址，如 https://api.openai.com/v1",
        "type": "string",
        "default": ""
      },
      "api_key": {
        "description": "API 密钥",
        "hint": "provider=api 时必填；也可用环境变量 EMBED_API_KEY 注入，避免明文入库",
        "type": "string",
        "default": ""
      },
      "api_model": {
        "description": "API 嵌入模型",
        "hint": "provider=api 时的模型名，如 text-embedding-3-small",
        "type": "string",
        "default": "text-embedding-3-small"
      }
    }
  },
  "scope": {
    "description": "作用域与隔离",
    "type": "object",
    "items": {
      "default_scope": {
        "description": "默认记忆作用域",
        "hint": "新记忆未指定作用域时的归属：会话级 / 工作区级 / 全局共享",
        "type": "string",
        "options": [
          "session",
          "workspace",
          "global"
        ],
        "default": "workspace"
      },
      "use_session_filtering": {
        "description": "按会话隔离",
        "hint": "召回时只返回当前会话或共享作用域的记忆",
        "type": "bool",
        "default": true
      },
      "use_workspace_filtering": {
        "description": "按工作区隔离",
        "hint": "召回时工作区记忆必须匹配当前工作区",
        "type": "bool",
        "default": true
      },
      "use_persona_filtering": {
        "description": "按人格隔离",
        "hint": "启用后记忆可按 persona_id 过滤（人格接口预留）",
        "type": "bool",
        "default": false
      }
    }
  },
  "injection": {
    "description": "记忆注入",
    "type": "object",
    "items": {
      "inject_enabled": {
        "description": "记忆注入总开关",
        "hint": "关闭后每轮不再向 systemPrompt 注入记忆与状态卡",
        "type": "bool",
        "default": true
      },
      "inject_card": {
        "description": "状态卡注入",
        "hint": "注入工作区状态卡（目标/当前方案/下一步）",
        "type": "bool",
        "default": true
      },
      "inject_order": {
        "description": "注入排序",
        "hint": "systemPrompt 中的位置：0=人格之后，100=工具说明之前",
        "type": "int",
        "default": 50
      },
      "inject_group": {
        "description": "注入组织形态",
        "hint": "category 分类展示 | summary 同类总结 | flat 平铺（默认 category+summary 混合）",
        "type": "string",
        "default": "category"
      },
      "preference_guarantee": {
        "description": "高价值偏好保底",
        "hint": "importance>=0.8 的偏好记忆保证进入注入（即使语义不匹配）",
        "type": "bool",
        "default": true
      }
    }
  },
  "recall_engine": {
    "description": "记忆召回",
    "type": "object",
    "items": {
      "top_k": {
        "description": "每轮注入条数",
        "hint": "每轮对话注入的长期记忆条数；越大信息越全但更占模型注意力",
        "type": "int",
        "default": 10
      },
      "max_k": {
        "description": "主动检索最大条数",
        "hint": "memory_recall 工具单次返回的最大条数",
        "type": "int",
        "default": 10
      },
      "min_similarity_for_retrieval": {
        "description": "召回最低相似度",
        "hint": "低于该余弦相似度的记忆不参与召回（0 表示不过滤）",
        "type": "float",
        "default": 0.0
      },
      "min_importance_for_retrieval": {
        "description": "召回最低重要性",
        "hint": "低于该重要性的记忆不参与召回",
        "type": "float",
        "default": 0.0
      },
      "recent_memory_count": {
        "description": "近期记忆保留数",
        "hint": "为最近写入的记忆保留的召回槽位，避免只按相似度排名",
        "type": "int",
        "default": 2
      },
      "recent_memory_max_age_hours": {
        "description": "近期记忆时间窗（小时）",
        "hint": "多少小时内的记忆视为近期",
        "type": "int",
        "default": 72
      }
    }
  },
  "fusion_strategy": {
    "description": "检索融合与加权",
    "type": "object",
    "items": {
      "rrf_k": {
        "description": "RRF 融合参数",
        "hint": "双路检索（BM25+向量）融合排序的 RRF 常数 k",
        "type": "int",
        "default": 60
      },
      "alpha": {
        "description": "相关性权重",
        "hint": "排序公式中检索相关性的权重（α）",
        "type": "float",
        "default": 0.5
      },
      "beta": {
        "description": "重要性权重",
        "hint": "排序公式中记忆重要性的权重（β）",
        "type": "float",
        "default": 0.25
      },
      "gamma": {
        "description": "时间新鲜度权重",
        "hint": "排序公式中时间新鲜度的权重（γ）",
        "type": "float",
        "default": 0.25
      },
      "merge_similarity_threshold": {
        "description": "近重复合并阈值（P0 默认关闭合并）",
        "hint": "新记忆与已有记忆余弦相似度超过该值时合并而非新增（v0.4 P0 默认 merge_enabled=false——相似仅发现候选，不覆盖/聚合）",
        "type": "float",
        "default": 0.85
      },
      "merge_enabled": {
        "description": "近重复合并开关（v0.4 P0 默认关闭）",
        "hint": "为兼容旧行为可设 true；P0 语义模型默认 false——相似记忆保留双条，仅为候选标记，不再覆盖既有条目",
        "type": "bool",
        "default": false
      },
      "atom_dedup_threshold": {
        "description": "原子查重阈值（Jaccard）",
        "hint": "新原子与同记忆已有原子的分词集合 Jaccard 相似度达到该值即视为重复，强化原原子而非新增",
        "type": "number",
        "default": 0.6
      }
    }
  },
  "reflection_engine": {
    "description": "记忆生成（自动抽取）",
    "type": "object",
    "items": {
      "extract_enabled": {
        "description": "自动抽取开关",
        "hint": "对话累积到阈值后自动用廉价 LLM 抽取长期记忆",
        "type": "bool",
        "default": true
      },
      "summary_trigger_messages": {
        "description": "抽取触发消息数",
        "hint": "累积多少条对话消息触发一次抽取（deepmemory 按消息计数，非轮次）",
        "type": "int",
        "default": 4
      },
      "extract_model": {
        "description": "抽取模型名称",
        "hint": "从已配置模型列表中选择，或填写自定义模型名；留空则自动选择最便宜的 chat 模型",
        "type": "string",
        "default": ""
      },
      "extract_provider": {
        "description": "抽取模型 Provider",
        "hint": "留空则自动从已配置模型列表中选择",
        "type": "string",
        "default": ""
      }
    }
  },
  "state_card": {
    "description": "会话状态卡",
    "type": "object",
    "items": {
      "auto_generate": {
        "description": "自动生成状态卡",
        "hint": "开启后，未自带 deepmemory 的会话（如 cordis）也会在对话达到阈值后自动生成 daily 会话卡；可按会话覆盖",
        "type": "boolean",
        "default": true
      },
      "sync_turns": {
        "description": "状态卡与压缩同步轮数",
        "hint": "每完成多少个对话轮次，同步一次状态卡并压缩最近 3 轮之前的历史",
        "type": "integer",
        "default": 5
      }
    }
  },
  "context_automation": {
    "description": "会话自动压缩与记忆补全",
    "type": "object",
    "items": {
      "enabled": {
        "description": "自动压缩与记忆补全",
        "hint": "开启后按状态卡同步周期自动压缩对话，并向所有会话注入状态卡与相关长期记忆；可按会话覆盖",
        "type": "boolean",
        "default": true
      },
      "memory_completion_k": {
        "description": "记忆补全条数",
        "hint": "每个会话最多注入的相关长期记忆数量",
        "type": "integer",
        "default": 5
      }
    }
  },
  "importance_decay": {
    "description": "重要性衰减",
    "type": "object",
    "items": {
      "decay_rate": {
        "description": "衰减率",
        "hint": "按天计算的记忆重要性衰减系数；被召回的记忆衰减更慢（访问强化）",
        "type": "float",
        "default": 0.01
      },
      "interval_hours": {
        "description": "自动衰减间隔（小时）",
        "hint": "默认 24 小时（每天一次）；改为 6 即每 6 小时执行一次，必须大于 0",
        "type": "float",
        "default": 24
      },
      "protected_importance_threshold": {
        "description": "重要记忆保护阈值",
        "hint": "重要性达到该值的记忆不参与衰减",
        "type": "float",
        "default": 0.85
      }
    }
  },
  "archiving": {
    "description": "归档与遗忘",
    "type": "object",
    "items": {
      "auto_archive_enabled": {
        "description": "自动归档开关（v0.4 P0 默认关闭）",
        "hint": "低重要性且过旧的记忆自动移入归档（不参与召回、可恢复）。v0.4 P0 语义模型默认关闭自动归档——archive 仅手动触发，保留 cold 层",
        "type": "bool",
        "default": false
      },
      "archive_importance_threshold": {
        "description": "归档重要性阈值",
        "hint": "衰减后重要性低于该值的记忆可被归档",
        "type": "float",
        "default": 0.1
      },
      "archive_days_threshold": {
        "description": "归档天数阈值",
        "hint": "创建超过该天数的记忆才允许自动归档",
        "type": "float",
        "default": 30.0
      },
      "retention_days": {
        "description": "archive tier 保留天数",
        "hint": "归档层保留期（默认不自动物理清理，软删可恢复优先）",
        "type": "float",
        "default": 365.0
      }
    }
  },
  "agent_tools": {
    "description": "Agent 记忆工具",
    "type": "object",
    "items": {
      "tools_enabled": {
        "description": "工具总开关",
        "hint": "关闭后三个记忆工具全部不可用",
        "type": "bool",
        "default": true
      },
      "enable_recall_tool": {
        "description": "主动回忆工具",
        "hint": "提供 memory_recall（按关键词语义召回记忆）",
        "type": "bool",
        "default": true
      },
      "enable_save_tool": {
        "description": "主动写入工具",
        "hint": "提供 memory_save（把偏好/事实/决定写入记忆库）",
        "type": "bool",
        "default": true
      },
      "enable_briefing_tool": {
        "description": "子代理简报工具",
        "hint": "提供 memory_briefing（为子任务生成记忆简报）",
        "type": "bool",
        "default": true
      }
    }
  },
  "search_cache": {
    "description": "检索缓存",
    "type": "object",
    "items": {
      "enabled": {
        "description": "启用检索缓存",
        "hint": "相同查询在 TTL 内直接复用结果，命中不更新访问计数",
        "type": "boolean",
        "default": true
      },
      "ttl_seconds": {
        "description": "缓存有效期（秒）",
        "type": "number",
        "default": 45
      },
      "max_entries": {
        "description": "缓存条目上限",
        "type": "number",
        "default": 256
      }
    }
  },
  "access_reinforcement": {
    "description": "访问强化参数组",
    "type": "object",
    "items": {
      "enabled": {
        "description": "启用访问强化衰减",
        "hint": "关闭后衰减不再参考最近访问时间",
        "type": "boolean",
        "default": true
      },
      "reference_weight": {
        "description": "访问时间参考权重",
        "hint": "1.0=完全以最近访问时间为基准（访问越新衰减越慢），0=只看创建时间",
        "type": "number",
        "default": 1.0
      },
      "protect_importance": {
        "description": "高重要度保护阈值",
        "hint": "重要度≥该值的记忆免于衰减",
        "type": "number",
        "default": 0.85
      },
      "cleanup_importance": {
        "description": "归档清理重要度阈值",
        "type": "number",
        "default": 0.1
      },
      "cleanup_days": {
        "description": "归档清理最小天数",
        "type": "number",
        "default": 30
      },
      "reinforce_atoms": {
        "description": "召回时强化原子",
        "hint": "被召回的活跃原子刷新强化计数并延长 TTL",
        "type": "boolean",
        "default": true
      },
      "atom_ttl_extension_days": {
        "description": "原子 TTL 延长天数",
        "type": "number",
        "default": 1.0
      }
    }
  },
  "sensitive": {
    "description": "敏感内容保护与临时授权",
    "type": "object",
    "items": {
      "approval_required": {
        "description": "展开敏感原文前要求当前用户确认",
        "type": "bool",
        "default": true
      },
      "approval_max_uses": {
        "description": "单个授权令牌最多展开次数",
        "type": "int",
        "default": 3
      },
      "approval_ttl_minutes": {
        "description": "授权令牌有效期（分钟）",
        "type": "int",
        "default": 30
      }
    }
  },
  "memory_consolidation": {
    "description": "记忆库定期整合",
    "type": "object",
    "items": {
      "enabled": {
        "description": "启用定期整合",
        "hint": "整合把高度相似的旧记忆合并为一条规范记忆，碎片化的旧条归档",
        "type": "boolean",
        "default": false
      },
      "auto_run_enabled": {
        "description": "夜间自动整合（v0.4 P0 默认关闭）",
        "hint": "v0.4 P0 关闭相似覆盖/聚合——夜间不再自动合并归档；candidates 仅标记，晋升需人工/事件。设为 true 可恢复旧夜间自动整合",
        "type": "boolean",
        "default": false
      },
      "trigger": {
        "description": "触发方式",
        "type": "string",
        "options": [
          "daily",
          "manual"
        ],
        "default": "daily"
      },
      "min_memories_per_group": {
        "description": "每组最少记忆数",
        "type": "number",
        "default": 2
      },
      "min_age_days": {
        "description": "最小记忆年龄（天）",
        "hint": "只整合创建超过该天数的记忆",
        "type": "number",
        "default": 1.0
      },
      "max_importance": {
        "description": "最大重要性",
        "hint": "只整合重要度不高于该值的记忆，保护重要记忆",
        "type": "number",
        "default": 0.5
      },
      "max_groups_per_run": {
        "description": "每次最多整合组数",
        "type": "number",
        "default": 5
      },
      "semantic_similarity_threshold": {
        "description": "语义聚类相似度阈值",
        "type": "number",
        "default": 0.92
      },
      "llm_summarize": {
        "description": "整合时用 LLM 生成合并摘要",
        "hint": "开启后插件侧调用模型对每组生成 canonical_summary 再应用；关闭则直接拼接原文",
        "type": "boolean",
        "default": false
      },
      "llm_provider": {
        "description": "整合模型 Provider",
        "hint": "从已配置模型列表中选择整合模型 Provider；留空自动选择",
        "type": "string",
        "default": ""
      },
      "llm_model": {
        "description": "整合模型名称",
        "hint": "从已配置模型列表中选择，或填写自定义模型名；留空自动选择",
        "type": "string",
        "default": ""
      }
    }
  },
  "compression": {
    "description": "deepmemory 独立压缩管线（不走 DSH 官方完全压缩）",
    "type": "object",
    "items": {
      "enabled": {
        "description": "自主压缩开关",
        "hint": "deepmemory 自己生成主题摘要链（不依赖官方 compaction 内容）",
        "type": "bool",
        "default": true
      },
      "min_turns": {
        "description": "(备选)按轮数触发",
        "hint": "0=不启用轮数触发，用 trigger_bytes",
        "type": "int",
        "default": 0
      },
      "summary_model": {
        "description": "摘要模型",
        "hint": "留空自动从已配置模型选择",
        "type": "string",
        "default": ""
      },
      "inject_summary": {
        "description": "注入摘要链",
        "hint": "注入时置顶主题摘要链（项目简介）",
        "type": "bool",
        "default": true
      },
      "trigger_bytes": {
        "description": "摘要链触发长度（字符）",
        "hint": "会话累计 user+assistant 文本字符数超过该值触发摘要链更新（约 4x 即 tokens）；0=禁用长度触发",
        "type": "int",
        "default": 60000
      },
      "retain_head": {
        "description": "摘要链保留最近原文条数",
        "hint": "更新摘要链时保留最近 N 条原文（后续细节可溯）",
        "type": "int",
        "default": 20
      }
    }
  },
  "library": {
    "description": "知识库分库（面向 agent 调度）",
    "type": "object",
    "items": {
      "vocabulary": {
        "description": "库词汇表",
        "hint": "bias=总行为约束/core=主体/eco=生态/project=项目/runtime=运行时默认",
        "type": "list",
        "default": [
          "bias",
          "core",
          "eco",
          "project",
          "runtime"
        ]
      },
      "bias_min_importance": {
        "description": "bias 库最低重要性",
        "hint": "行为约束写入 bias 库需 importance>=该值",
        "type": "float",
        "default": 0.8
      },
      "bias_protected": {
        "description": "bias 库永不归档",
        "hint": "禁止对 bias 库执行归档（archive-library 拒绝 403）",
        "type": "bool",
        "default": true
      }
    }
  }
}